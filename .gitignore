# 数据与模型权重不入库：按 README 下载或自行放到这两个目录
data/*
!data/.gitkeep
# 例外：作业用的短评数据集随仓库提供（评阅时无需爬取），
# 但同目录下的登录态 storage_state.json 含账号 cookie，必须继续忽略
!data/douban/
data/douban/*
!data/douban/*.jsonl
models/*
!models/.gitkeep
# 例外：作业用的 bge-small-zh-v1.5 权重随仓库提供（约 92MB），
# 让评阅者 clone 后无需联网下载即可直接跑 train / webapp；
# 只排除 huggingface 的下载缓存元数据
!models/bge-small-zh-v1.5/
models/bge-small-zh-v1.5/.cache/

# 训练产物
artifacts/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 系统与工具
.DS_Store
.idea/
.workbuddy/
*.log
